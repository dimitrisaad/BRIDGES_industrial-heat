#!/bin/bash

#SBATCH --job-name=BRIDGES
#SBATCH --mail-type=ALL
#SBATCH --mail-user=dimi3@stanford.edu

#SBATCH --time=3:59:00
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --mem=70GB
#SBATCH --cpus-per-task=16
#SBATCH --partition=serc
#SBATCH -o Output/SLURM/slurm-%j.out

# Load modules here
ml load julia
ml load gurobi

# Run your script
srun julia run_file.jl